# Required
# CALLE_API_KEY: from the CALL-E dashboard
CALLE_API_KEY=
# GROQ_API_KEY: from console.groq.com (free)
GROQ_API_KEY=

# Optional runtime toggles. Leave them unset for the default mock demo (no calls).
# Uncomment and set to try real calls with your own keys.

# MOCK: default is mock (no calls). Set to false to place REAL phone calls.
# MOCK=false

# TEST_PHONES: with MOCK=false, call these YOUR numbers instead of real shops (safe testing).
# TEST_PHONES=+14155550123,+14155550143

# GROQ_MODEL: override the intake model.
# GROQ_MODEL=openai/gpt-oss-20b

# STEP_MS: live-board reveal delay in ms.
# STEP_MS=500
